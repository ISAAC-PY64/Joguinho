# Frontend URL of the independently hosted Socket.IO server. Use https:// in production.
VITE_SERVER_URL=http://localhost:3001

# Backend HTTP port (the hosting provider usually assigns this automatically).
PORT=3001

# Comma-separated exact browser origins allowed to call the backend.
# Example: https://monster-haven.example,capacitor://localhost
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL connection string for persistent rooms, matches, and profile backups.
# Leave empty for local JSON storage only; never commit a real connection string.
DATABASE_URL=
PGSSLMODE=require
PGPOOL_MAX=5

# Optional path for local JSON data when DATABASE_URL is not set.
DATA_DIR=
